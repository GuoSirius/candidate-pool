node_modules/
npm-debug.log*
.DS_Store
*.log

# 临时产物（CI / 本地测试生成，不入库）
reports/_*.html
data/_*.json

# 尾盘选股运行产物
#   - 主存档 eod/data/eod-*.json（精简 records，**按约定提交 git**，网页/D1 不依赖）
#   - 原始快照 eod/data/raw/（全市场 quotes + 分时 minutes，~6MB/日，体积大 → 不入库）
#   - 报告 eod/reports/eod-*.html（提交 git，便于查看历史）
eod/data/_*.json
eod/data/raw/
eod/reports/_*.html
!eod/data/industry_mapping.json

# 推送凭据（含 163 授权码 / 微信 key，切勿提交）
notify_config.json

# Cloudflare D1 凭据（含 account_id / database_id / API token，切勿提交）
db/.env

# 本地触发 GitHub dispatch 的 token 兜底文件（切勿提交）
.github/dispatch-token

# 本地数据库文件（若改成本地 sqlite 调试，勿入库）
*.sqlite
*.sqlite3
*.db
db/local.db*

# 运行时/自动化本地目录
.workbuddy/

# Wrangler 本地状态（缓存 / 构建临时产物 / 本地 D1 数据，勿入库）
.wrangler/
.dev.vars
.dev.vars.*

# 发布临时产物（release-notes.md 由 CI 生成；*.tgz 来自本地 npm pack）
release-notes.md
*.tgz

# 本地临时诊断目录
.tmp/
