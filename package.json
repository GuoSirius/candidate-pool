{
  "name": "candidate-pool",
  "version": "1.0.0",
  "description": "A股次日候选池自动初筛（R01 量能验证突破 + R07 板块内补涨），数据取自腾讯公开行情接口，输出单文件双语 HTML 报告",
  "private": true,
  "scripts": {
    "start": "node gen_candidates.js",
    "run": "node gen_candidates.js",
    "live": "node gen_candidates.js",
    "offline": "node gen_candidates.js --offline --snapshot data/snapshot-2026-07-27.json --out reports/stock_list_20260727.html",
    "universe": "node build_universe.js",
    "universe:dry": "node build_universe.js --dry",
    "notify": "node notify.js"
  },
  "engines": {
    "node": ">=18"
  }
}
