{
  "name": "candidate-pool",
  "version": "3.6.0",
  "description": "A股短线选股工具包：次日候选池初筛（R01 量能验证突破 + R07 板块内补涨）、尾盘选股（14:50 口径）与形态选股（四类形态双引擎、全市场盲扫），数据取自腾讯公开行情接口，输出单文件双语 HTML 报告",
  "bin": {
    "candidate-pool": "bin/candidate-pool.js",
    "tail-screener": "bin/tail-screener.js"
  },
  "files": [
    "bin/",
    "paths.js",
    "paths.selftest.js",
    "scaffold.js",
    "scaffold.selftest.js",
    "time.js",
    "gen_candidates.js",
    "notify.js",
    "build_universe.js",
    "candidates.example.json",
    "notify_config.example.json",
    "eod/",
    "db/",
    "README.md",
    "CHANGELOG.md",
    "!eod/reports/",
    "!eod/data/eod-*.json",
    "!db/.env",
    "!db/local.db*",
    "!**/*.log"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuoSirius/candidate-pool.git"
  },
  "keywords": [
    "a-share",
    "stock-screener",
    "quant",
    "选股",
    "尾盘选股",
    "形态选股",
    "量化"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "node gen_candidates.js",
    "run": "node gen_candidates.js",
    "live": "node gen_candidates.js",
    "offline": "node gen_candidates.js --offline",
    "tail": "node eod/tail_screener.js",
    "tail:intraday": "node eod/tail_screener.js --intraday",
    "tail:replay": "node eod/tail_screener.js --replay",
    "tail:selftest": "node eod/lib/trading.selftest.js",
    "verdict:selftest": "node eod/lib/verdict.selftest.js",
    "regime:selftest": "node eod/lib/regime.selftest.js",
    "fmt:selftest": "node eod/lib/report_fmt.selftest.js",
    "nextday": "node eod/nextday_backfill.js",
    "pool:reflow": "node eod/pool_reflow.js",
    "pool:selftest": "node eod/pool_reflow.selftest.js",
    "weekly:winrate": "node eod/weekly_winrate.js",
    "weekly:selftest": "node eod/weekly_winrate.selftest.js",
    "preopen": "node eod/preopen_screener.js",
    "preopen:watchlist": "node eod/preopen_screener.js --scope watchlist",
    "preopen:baseline": "node eod/preopen_screener.js --baseline",
    "preopen:backfill": "node eod/preopen_backfill.js",
    "pattern": "node eod/pattern_screener.js",
    "pattern:replay": "node eod/pattern_screener.js --replay",
    "pattern:calibrate": "node eod/pattern_calibrate.js",
    "pattern:backfill": "node eod/pattern_backfill.js",
    "pattern:selftest": "node eod/lib/pattern.selftest.js",
    "report:rerender": "node eod/rerender_all.js",
    "report:history-briefs": "node eod/rebuild_history_briefs.js",
    "pulse": "node pulse/run.js",
    "pulse:watch": "node pulse/watch.js",
    "pulse:probe": "node pulse/probe.mjs",
    "paths": "node gen_candidates.js --paths",
    "paths:selftest": "node paths.selftest.js",
    "init": "node gen_candidates.js --init",
    "scaffold:selftest": "node scaffold.selftest.js",
    "selftest": "npm run paths:selftest && npm run scaffold:selftest && npm run tail:selftest && npm run verdict:selftest && npm run regime:selftest && npm run fmt:selftest && npm run pool:selftest && npm run weekly:selftest && npm run pattern:selftest && npm run report:history-briefs -- --check && npm run db:selftest",
    "universe": "node build_universe.js",
    "universe:dry": "node build_universe.js --dry",
    "notify": "node notify.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:local": "node db/migrate.js --local",
    "db:migrate:both": "node db/migrate.js --both",
    "db:migrate:dry": "node db/migrate.js --dry-run",
    "db:selftest": "node db/diff_selftest.js",
    "db:sync": "node db/backfill.js --both",
    "db:verify": "node db/verify_sync.js",
    "db:local": "node db/backfill.js --local",
    "deploy": "npm run deploy --prefix ./web",
    "setup": "npm install && npm install --prefix ./worker && npm install --prefix ./web",
    "typecheck": "npm run typecheck --prefix ./worker && npm run typecheck --prefix ./web",
    "changelog": "changelogen",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "pack:dry": "npm pack --dry-run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "changelogen": "latest",
    "husky": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dayjs": "latest",
    "dotenv": "latest"
  }
}
