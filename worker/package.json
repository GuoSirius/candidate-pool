{
  "name": "candidate-pool-api",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers API exposing candidate-pool D1 data as uniform { code, message, data } JSON",
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.134.0"
  }
}
