{
  "name": "candidate-pool-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers API exposing candidate-pool D1 data as uniform { code, message, data } JSON",
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
