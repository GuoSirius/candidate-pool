{
  "name": "candidate-pool-api",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers API exposing candidate-pool D1 data as uniform { code, message, data } JSON",
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24"
  }
}
