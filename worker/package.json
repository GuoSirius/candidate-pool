{
  "name": "candidate-pool-api",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers API exposing candidate-pool D1 data as uniform { code, message, data } JSON",
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dayjs": "latest",
    "hono": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
